module exp_docs_language_contract

/*md
# Documentation language contract

This markdown block is narrative documentation only.
*/
meta {
  id: "exp-docs-language-contract"
  title: "Docs language contract"
  date: "2026-05-29"
  primary_reaction: @rxn_main
  primary_result: @res_main
}

/// Substrate declaration attached to the molecule.
molecule mol_substrate {
  name: "substrate"
  smiles: "CCO"
}

molecule mol_product {
  name: "product"
  smiles: "CC=O"
}

/// Reaction doc comments are renderable but do not create facts.
reaction rxn_main {
  reactants: [@mol_substrate]
  products: [@mol_product]
  solvent: "MeCN"
  temperature: 60 C
}

result res_main for @rxn_main {
  product: @mol_product
  status: success
  yield: 74%
}

analysis ana_main for @res_main {
  type: tlc
  ref: @res_main
  notes: "one major spot"
}

procedure proc_main for @rxn_main {
  evidence: [@res_main]
  step charge = charge(inputs: [@mol_substrate])
  step heat = heat(temperature: 60 C, duration: 3 h, depends_on: [charge])
}

observation obs_main for @rxn_main {
  notes: "yellow solution"
}

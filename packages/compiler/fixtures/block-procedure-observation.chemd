---
id: exp-block-procedure-observation
title: Procedure and observation block contract
date: 2026-05-19
primary_reaction: rxn-main
primary_result: res-main
---

:::chemd #mol-start
kind: molecule
name: aldehyde
smiles: O=CC
:::

:::chemd #mol-product
kind: molecule
name: alcohol
smiles: OCC
:::

:::chemd #rxn-main
kind: reaction
reactants: @mol-start
products: @mol-product
reagents: NaBH4
solvent: MeOH
temperature: 0 C
time: 1 h
:::

:::result #res-main
reaction: rxn-main
product: mol-product
status: success
yield: 80 %
:::

:::procedure #proc-main
ref: rxn-main
reaction: rxn-main
evidence: notebook-page-08
step: charge | id=s-charge | inputs=@mol-start | outputs=mixture-a | evidence=notebook-page-08 | confidence=0.98
step: cool | id=s-cool | temperature=0 C | dependsOn=s-charge

:::step #s-add
family: add
stage: reaction
inputs: NaBH4
outputs: mixture-b
dependsOn: s-cool
evidence: notebook-page-08
confidence: 0.95
:::

step: hold | id=s-hold | duration=1 h | dependsOn=s-add
step: analyze | id=s-analyze | analysisType=tlc | dependsOn=s-hold
:::

:::observation #obs-main
ref: rxn-main
event: color_change | id=e-color | value=colorless | linkedStep=s-add | evidence=notebook-page-08 | confidence=0.8

:::event #e-gas
type: gas_evolution
severity: low
linkedStep: s-add
evidence: notebook-page-08
confidence: 0.7
:::
:::

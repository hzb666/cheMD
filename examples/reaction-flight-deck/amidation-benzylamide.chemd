module demo_amidation_benzylamide

import demo_shared_reagents as shared from "./shared-reagents.chemd"

meta {
  id: "demo-amidation-benzylamide"
  title: "Boric acid catalyzed direct amide formation"
  date: "2026-06-04"
  primary_reaction: @rxn_amide_benzyl
  primary_result: @res_amide
}

reaction rxn_amide_benzyl {
  name: "N-benzyl-4-phenylbutyramide by direct amidation"
  reactants: [@shared.mol_4_phenylbutyric_acid, @shared.mol_benzylamine]
  products: [@shared.mol_n_benzyl_4_phenylbutyramide]
  catalyst: "boric acid"
  solvent: "toluene"
  time: 16 h
}

analysis ana_amide {
  type: hplc
  ref: @res_amide
  status: clean
  result: "demo HPLC purity above release threshold"
}

result res_amide for @rxn_amide_benzyl {
  product: @shared.mol_n_benzyl_4_phenylbutyramide
  status: success
  yield: 91%
  purity: 98%
}

procedure proc_amidation for @rxn_amide_benzyl {
  evidence: [@res_amide, @ana_amide]

  step charge_acid = charge(materials: "4-phenylbutyric acid")
  step add_catalyst = add(materials: "boric acid", depends_on: [charge_acid])
  step add_amine = add(materials: "benzylamine", depends_on: [add_catalyst])
  wait operator_gate(condition: "operator.confirmed")
  abort_if overheated(condition: "sensor.temperature > 125 C")
  step reflux = heat(duration: 16 h, depends_on: [add_amine, operator_gate])
  step sample_product = sample(depends_on: [reflux])
  step dry_product = dry(method: "vacuum", depends_on: [sample_product])
  step analyze_product = analyze(type: hplc, inputs: [dry_product])
  abort_if low_purity(condition: "@res_amide.purity < 95%")
}

agent run amidation_audit {
  goal: "verify direct amidation result and release criteria"
  status: completed
  evidence: [@rxn_amide_benzyl, @res_amide, @ana_amide]

  tool compile_current_file {
    status: ok
    evidence: [@res_amide]
  }

  timeline completed {
    at: "2026-06-04T00:00:00Z"
    actor: "codex"
    summary: "demo source validated"
    tool: "compile_current_file"
    evidence: [@res_amide]
  }
}

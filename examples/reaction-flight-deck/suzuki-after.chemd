module demo_suzuki_diff_after

meta {
  id: "demo-suzuki-diff"
  title: "Suzuki diff after"
  date: "2026-06-04"
  primary_reaction: @rxn_suzuki_pyrimidine
  primary_result: @res_suzuki
}

molecule mol_5_bromopyrimidine {
  name: "5-bromopyrimidine"
}

molecule mol_3_furanylboronic_acid {
  name: "3-furanylboronic acid"
}

molecule mol_product {
  name: "5-(furan-3-yl)pyrimidine"
}

reaction rxn_suzuki_pyrimidine {
  reactants: [@mol_5_bromopyrimidine, @mol_3_furanylboronic_acid]
  products: [@mol_product]
  catalyst: "NiCl2(PCy3)2"
  solvent: "tert-amyl alcohol"
  temperature: 120 C
  time: 12 h
}

result res_suzuki for @rxn_suzuki_pyrimidine {
  product: @mol_product
  status: success
  yield: 86%
  purity: 97%
}

procedure proc_suzuki for @rxn_suzuki_pyrimidine {
  step charge = charge(materials: "heteroaryl partners")
  wait operator_gate(condition: "operator.confirmed")
  abort_if overheated(condition: "sensor.temperature > 130 C")
  step heat = heat(temperature: 120 C, duration: 12 h, depends_on: [charge, operator_gate])
}

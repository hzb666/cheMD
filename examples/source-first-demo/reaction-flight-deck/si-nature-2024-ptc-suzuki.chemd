module si_nature_2024_ptc_suzuki

import demo_shared_reagents as shared from "./shared-reagents.chemd"

meta {
  id: "si-nature-2024-ptc-suzuki"
  title: "Nature Communications 2024 SI phase-transfer Suzuki kinetics"
  date: "2024-06-27"
  primary_reaction: @rxn_nature_2024_standard
  primary_result: @res_nature_2024_standard
}

reaction rxn_nature_2024_standard {
  name: "Biphasic Suzuki-Miyaura coupling standard kinetic run"
  reactants: [@shared.mol_benzyl_bromide, @shared.mol_4_methoxyphenylboronic_pinacol_ester]
  products: [@shared.mol_nature_2024_product_3]
  catalyst: @shared.cat_xphos_pd_g2
  reagents: @shared.mol_k2co3
  solvent: [@shared.mol_2_methf, @shared.mol_water]
  temperature: 80 C
  atmosphere: argon
}

artifact art_nature_2024_si {
  kind: supporting_information
  ref: @rxn_nature_2024_standard
  path: "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-024-49681-4/MediaObjects/41467_2024_49681_MOESM1_ESM.pdf"
  notes: "Supplementary Information for DOI 10.1038/s41467-024-49681-4."
}

analysis ana_nature_2024_hplc {
  type: hplc
  ref: @rxn_nature_2024_standard
  artifact: [@art_nature_2024_si]
  notes: "SI describes online HPLC monitoring of benzyl bromide, arylboronate ester, product 3, halides, and parent boronic acid."
}

analysis ana_nature_2024_vtna {
  type: literature_extract
  ref: @rxn_nature_2024_standard
  artifact: [@art_nature_2024_si]
  notes: "Article reports VTNA reagent orders and interprets the kinetic regime as rate-determining transmetalation coupled to a base-mediated pre-equilibrium."
}

result res_nature_2024_standard for @rxn_nature_2024_standard {
  product: @shared.mol_nature_2024_product_3
  status: success
  notes: "Standard kinetic run used benzyl bromide, arylboronate ester 2, XPhos Pd G2, K2CO3, 2-MeTHF/water, 80 C, and online HPLC monitoring."
}

procedure proc_nature_2024_standard for @rxn_nature_2024_standard {
  evidence: [@art_nature_2024_si, @ana_nature_2024_hplc, @ana_nature_2024_vtna]

  step charge_boron = charge(materials: "4-methoxyphenylboronic ester", inputs: [@shared.mol_4_methoxyphenylboronic_pinacol_ester])
  step add_organic_solvent = add(materials: "2-MeTHF", inputs: [@shared.mol_2_methf], depends_on: [charge_boron])
  step add_benzyl_bromide = add(materials: "benzyl bromide", inputs: [@shared.mol_benzyl_bromide], depends_on: [add_organic_solvent])
  step heat_to_80 = heat(temperature: 80 C, depends_on: [add_benzyl_bromide])
  step add_catalyst_solution = add(materials: "XPhos Pd G2 solution", inputs: [@shared.cat_xphos_pd_g2], depends_on: [heat_to_80])
  step add_base_solution = add(materials: "K2CO3 in water", inputs: [@shared.mol_k2co3, @shared.mol_water], depends_on: [add_catalyst_solution])
  step sample_hplc = sample(depends_on: [add_base_solution])
  step analyze_hplc = analyze(type: hplc, inputs: [@shared.mol_benzyl_bromide, @shared.mol_4_methoxyphenylboronic_pinacol_ester, @shared.mol_nature_2024_product_3], depends_on: [sample_hplc])
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@chemd/core": ["packages/core/src/index.ts"],
      "@chemd/parser": ["packages/parser/src/index.ts"],
      "@chemd/diagnostics": ["packages/diagnostics/src/index.ts"],
      "@chemd/step-ontology": ["packages/step-ontology/src/index.ts"],
      "@chemd/typechecker": ["packages/typechecker/src/index.ts"],
      "@chemd/runtime-lab": ["packages/runtime-lab/src/index.ts"],
      "@chemd/runtime-trace": ["packages/runtime-trace/src/index.ts"],
      "@chemd/lnf": ["packages/lnf/src/index.ts"],
      "@chemd/resolver": ["packages/resolver/src/index.ts"],
      "@chemd/render-profile": ["packages/render-profile/src/index.ts"],
      "@chemd/renderer-html": ["packages/renderer-html/src/index.ts"],
      "@chemd/renderer-json": ["packages/renderer-json/src/index.ts"],
      "@chemd/renderer-docx": ["packages/renderer-docx/src/index.ts"],
      "@chemd/compiler": ["packages/compiler/src/index.ts"],
      "@chemd/cli": ["packages/cli/src/index.ts"],
      "@chemd/exporter-training": ["packages/exporter-training/src/index.ts"],
      "@chemd/storage-postgres": ["packages/storage-postgres/src/index.ts"],
      "@chemd/language-service": ["packages/language-service/src/index.ts"],
      "@chemd/workspace-index": ["packages/workspace-index/src/index.ts"],
      "@chemd/semantic-rendering": ["packages/semantic-rendering/src/index.ts"],
      "@chemd/reaction-map": ["packages/reaction-map/src/index.ts"],
      "@chemd/agent-tools": ["packages/agent-tools/src/index.ts"]
    }
  }
}

{
  "name": "@chemd/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 2437",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "vitest run --config vitest.config.ts --pool=threads",
    "test:coverage": "vitest run --config vitest.config.ts --coverage --pool=threads",
    "coverage:tauri": "node scripts/tauri-coverage.mjs",
    "coverage": "pnpm run test:coverage && pnpm run coverage:tauri",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@chemd/agent-tools": "workspace:*",
    "@chemd/language-service": "workspace:*",
    "@chemd/reaction-map": "workspace:*",
    "@chemd/renderer-html": "workspace:*",
    "@chemd/renderer-json": "workspace:*",
    "@chemd/semantic-rendering": "workspace:*",
    "@chemd/workspace-index": "workspace:*",
    "@fontsource/geist": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "force-graph": "^1.51.4",
    "lucide-react": "^1.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.2",
    "@tauri-apps/cli": "^2.6.1",
    "@types/node": "^24.12.0",
    "@vitest/coverage-v8": "3.2.4",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.3.2"
  }
}

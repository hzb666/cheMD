{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chemd Desktop IDE",
  "version": "0.1.0",
  "identifier": "dev.chemd.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:2437",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chemd Desktop IDE",
        "label": "main",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

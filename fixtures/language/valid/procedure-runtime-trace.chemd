:::chemd #mol-substrate
kind: molecule
name: ethanol
smiles: CCO
:::

:::material #mat-substrate
molecule: @mol-substrate
supplier: internal
lot: demo-1
:::

:::chemd #rxn-main
kind: reaction
name: runtime trace demo
reactant: @mat-substrate | 1.0 mmol | 1.0 eq | limiting=true
product: traced product
temperature: 40 C
:::

:::result #res-main
reaction: @rxn-main
product: traced product
status: success
yield: 70 %
:::

:::analysis #ana-tlc
type: tlc
ref: @rxn-main
lane: sm | ref=@mat-substrate
spot: 0.20 ^2(3) sm
lane: rxn | ref=@proc-main
spot: 0.45 ^3(4) product
result: complete
:::

:::procedure #proc-main
ref: @rxn-main
step: charge | id=s-charge | inputs=@mat-substrate | outputs=mixture-a | vessel=reactor-1

repeat: wash-cycle | count=2 {
  step: wash | solvent=brine | volume=10 mL
}

parallel: workup {
  path: organic {
    step: dry | id=s-dry | medium=Na2SO4
  }
  path: aqueous {
    step: store | id=s-store | location=waste
  }
}

wait: operator-approval | condition=operator.confirmed | timeout=30 min
step: heat | id=s-heat | temperature=40 C | duration=30 min | dependsOn=s-charge,operator-approval
:::

:::trace #run-main
plan: @proc-main
mode: human-run
event: run_started | at=2026-05-20T10:00:00Z
event: step_started | step=s-charge | at=2026-05-20T10:01:00Z
event: step_completed | step=s-charge | at=2026-05-20T10:02:00Z
event: control_entered | control=operator-approval | at=2026-05-20T10:03:00Z
event: control_completed | control=operator-approval | at=2026-05-20T10:04:00Z
event: step_started | step=s-heat | at=2026-05-20T10:05:00Z
event: deviation_recorded | step=s-heat | field=temperature | expected=40 C | actual=45 C
event: step_completed | step=s-heat | at=2026-05-20T10:35:00Z
event: resource_consumed | material=@mat-substrate | amount=1.0 mmol
event: run_completed | at=2026-05-20T10:36:00Z
:::

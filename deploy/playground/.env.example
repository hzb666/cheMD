PUBLIC_WEB_PORT=2436
CHEM_SERVICE_ALLOW_ORIGINS=http://localhost

# Required shared secret between apps/web and chem-service.
# Generate a deployment-specific value before running docker compose.
CHEM_SERVICE_ACCESS_KEY=

CHEM_SERVICE_MOLECULE_OCR_PROVIDER=placeholder
CHEM_SERVICE_REACTION_OCR_PROVIDER=placeholder

# Optional: enable DOCX export if Pandoc is available in the web image.
PANDOC_PATH=

# Optional: Lab storage integration.
LAB_STORAGE_BASE_URL=
LAB_STORAGE_USERNAME=
LAB_STORAGE_PASSWORD=
LAB_STORAGE_DEVICE_ID=chemd-lab-storage-proxy
LAB_STORAGE_DEVICE_NAME=chemd server proxy

# Optional reaction OCR provider.
CHEM_SERVICE_RXNSCRIBE_API_URL=
CHEM_SERVICE_RXNSCRIBE_TIMEOUT_SECONDS=60
CHEM_SERVICE_RXNSCRIBE_API_KEY=

# Optional molecule OCR providers.
CHEM_SERVICE_DECIMER_API_URL=
CHEM_SERVICE_DECIMER_TIMEOUT_SECONDS=60
CHEM_SERVICE_DECIMER_API_KEY=
CHEM_SERVICE_MOLSCRIBE_API_URL=
CHEM_SERVICE_MOLSCRIBE_TIMEOUT_SECONDS=60
CHEM_SERVICE_MOLSCRIBE_API_KEY=
CHEM_SERVICE_MOLNEXTR_API_URL=
CHEM_SERVICE_MOLNEXTR_TIMEOUT_SECONDS=60
CHEM_SERVICE_MOLNEXTR_API_KEY=

[Unit]
Description=chemd playground chem-service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chemd
Group=chemd
WorkingDirectory=/srv/chemd/services/chem-service
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/chemd/playground/chem-service.env
ExecStart=/srv/chemd/services/chem-service/.venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

NODE_ENV=production
CHEM_SERVICE_BASE_URL=http://127.0.0.1:18081

# Set this only when apps/web talks to a remote chem-service host.
# CHEM_SERVICE_ACCESS_KEY=

# Optional: enable DOCX export if Pandoc is installed.
# PANDOC_PATH=/usr/bin/pandoc

# Optional: Lab storage integration.
# LAB_STORAGE_BASE_URL=https://lab.example.com/api
# LAB_STORAGE_USERNAME=
# LAB_STORAGE_PASSWORD=
# LAB_STORAGE_DEVICE_ID=chemd-lab-storage-proxy
# LAB_STORAGE_DEVICE_NAME=chemd server proxy
